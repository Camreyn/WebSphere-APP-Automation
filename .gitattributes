* text=auto

# AAP, Ansible, container, and Unix entrypoint files must retain LF endings.
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.props text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Keep Windows operator scripts native when checked out on Windows.
*.ps1 text eol=crlf
